aws_region       = "eu-north-1"
project_name     = "tutedude-cicd"
instance_type    = "t3.medium"  # NOT free-tier eligible; drop to t3.micro to test that limit yourself
key_name         = "your-ec2-keypair-name"
allowed_ssh_cidr = "YOUR_IP/32"
github_repo_url  = "https://github.com/Aswin-Shine/tutedude-flask-app.git"
backend_port     = 5000
frontend_port    = 3000
jenkins_port     = 8080
mongo_secret_name = "tutedude-cicd/mongo-uri"  

vpc_cidr           = "10.2.0.0/16"
public_subnet_cidr = "10.2.1.0/24"
