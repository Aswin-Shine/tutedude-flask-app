# This is a TEMPLATE, not a real file to apply. Do not fill in the real
# value and commit this. Kubernetes Secrets are base64-encoded, not
# encrypted, base64 is trivially reversible, so a committed Secret yaml
# with a real value is exactly as exposed as committing the plaintext.
#
# Create the real secret imperatively instead (never touches git):
#
#   kubectl create secret generic mongo-secret \
#     --from-literal=MONGO_URI='mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority'
#
# backend-deployment.yaml already references this secret by name
# (mongo-secret, key MONGO_URI) via secretKeyRef, so once the secret
# above exists in the cluster, `kubectl apply -f k8s/` just works.

apiVersion: v1
kind: Secret
metadata:
  name: mongo-secret
type: Opaque
stringData:
  MONGO_URI: "<fill in locally, never commit this file with a real value>"
